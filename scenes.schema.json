{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Explainer scenes.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "scenes"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "brand": { "type": "string", "maxLength": 24 },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "duration"],
      "properties": {
        "type": { "enum": ["title", "content", "stat", "bullets", "quote", "outro"] },
        "duration": { "type": "integer", "minimum": 4, "maximum": 10 },
        "kicker": { "type": "string", "maxLength": 48 },
        "heading": { "type": "string", "maxLength": 72 },
        "text": { "type": "string", "maxLength": 140 },
        "image": { "type": "string", "pattern": "^https?://" },
        "badge": { "type": "string", "maxLength": 30 },
        "stat": { "type": "string", "maxLength": 16 },
        "source": { "type": "string", "maxLength": 80 },
        "bullets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "type": "string", "maxLength": 64 }
        },
        "quote": { "type": "string", "maxLength": 160 },
        "attribution": { "type": "string", "maxLength": 64 },
        "cta": { "type": "string", "maxLength": 42 },
        "narration": { "type": "string", "maxLength": 600 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "title" } }, "required": ["type"] },
          "then": { "required": ["heading"] }
        },
        {
          "if": { "properties": { "type": { "const": "content" } }, "required": ["type"] },
          "then": { "required": ["heading", "text"] }
        },
        {
          "if": { "properties": { "type": { "const": "stat" } }, "required": ["type"] },
          "then": { "required": ["stat", "text"] }
        },
        {
          "if": { "properties": { "type": { "const": "bullets" } }, "required": ["type"] },
          "then": { "required": ["heading", "bullets"] }
        },
        {
          "if": { "properties": { "type": { "const": "quote" } }, "required": ["type"] },
          "then": { "required": ["quote"] }
        }
      ]
    }
  }
}
